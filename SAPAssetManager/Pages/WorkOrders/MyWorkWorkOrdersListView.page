{
	"OnLoaded": "/SAPAssetManager/Rules/WorkOrders/ListView/WorkOrderListViewOnPageLoad.js",
	"OnReturning": "/SAPAssetManager/Rules/WorkOrders/WorkOrderListViewOnReturning.js",
	"Caption": "/SAPAssetManager/Rules/WorkOrders/WorkOrderListViewCaption.js",
	"ActionBar":
	{
		"_Name": "WorkOrderList",
		"Items":
		[
		"/SAPAssetManager/Pages/Fragments/SyncButton.fragment",
		{
			"Position": "Right",
			"_Name": "Add",
			"Icon": "sap-icon://add",
			"Text": "$(L,add)",
			"Visible": "/SAPAssetManager/Rules/UserAuthorizations/WorkOrders/EnableWorkOrderCreate.js",
			"OnPress": "/SAPAssetManager/Rules/WorkOrders/CreateUpdate/WorkOrderCreateNav.js"
		},
		{
			"Position": "Right",
			"_Name": "Assign",
			"Text": "$(L,workorders_assign)",
			"Visible": "/SAPAssetManager/Rules/Supervisor/SupervisorRole/IsSupervisorSectionVisibleForWO.js",
			"OnPress": "/SAPAssetManager/Rules/Supervisor/Assign/WorkOrderAssignNav.js"
		},
		{				
			"_Type": "Fragment",
			"Fragment": "/SAPAssetManager/Pages/Fragments/FilterButton.fragment",
			"Properties": {
				"OnPress": "/SAPAssetManager/Actions/WorkOrders/WorkOrderFilter.action"
			}
		},
		{
			"Position": "Right",
			"_Name": "OnlineSearch",
			"Text": "$(L, online_search)",
			"Icon": "sap-icon://world",
			"OnPress": "/SAPAssetManager/Rules/OnlineSearch/WorkOrders/OnlineSearchFromWorkOrdersNav.js",
			"Visible": "/SAPAssetManager/Rules/OnlineSearch/IsOnlineSearchEnabled.js"
		}]
	},
	"Controls":
	[{
		"LoadingIndicator": {
			"Enabled": true
		},
		"Sections":
		[{
			"_Type": "Fragment",
			"Fragment": "/SAPAssetManager/Pages/Fragments/ListView/WorkOrdersListView.fragment"
		}],
		"FilterFeedbackBar": {
			"_Type": "Control.Type.FilterFeedbackBar",
			"_Name": "FilterFeedback",
			"ShowAllFilters": true,
			"FastFilters": "/SAPAssetManager/Rules/WorkOrders/ListView/FastFilters/WorkOrderFastFiltersItems.js"
		},
		"Filters": "/SAPAssetManager/Rules/WorkOrders/ListView/WorkOrdersListViewDefaultFilters.js",
		"_Type" : "Control.Type.SectionedTable",
		"_Name" : "SectionedTable"
	}],
	"_Type": "Page",
	"_Name": "MyWork_WorkOrdersListViewPage",
	"DataSubscriptions": ["PMMobileStatuses","MyWorkOrderHeaderLongTexts","UserTimeEntries","MyWorkOrderPartners","UserPreferences"]
}