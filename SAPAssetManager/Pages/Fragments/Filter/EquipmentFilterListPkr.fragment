{
    "_Name": "EquipmentFilter",
    "_Type": "Control.Type.FormCell.ListPicker",
    "Caption": "$(L,equipment_mult)",
    "AllowMultipleSelection": true,
    "IsPickerDismissedOnSelection": false,
    "IsSearchCancelledAfterSelection": true,
    "Search": {
        "Enabled": true,
        "Delay": 500,
        "MinimumCharacterThreshold": 3,
        "Placeholder": "$(L,search)",
        "BarcodeScanner": true
    },
    "Label": "$(L,equipment)",
    "FilterProperty": "HeaderEquipment",
    "PickerItems": {
        "ObjectCell": {
            "Title": "{EquipDesc}",
            "Subhead": "{EquipId}",
            "PreserveIconStackSpacing": false
        },
        "ReturnValue": "{EquipId}",
        "Target": {
            "EntitySet": "MyEquipments",
            "Service": "/SAPAssetManager/Services/AssetManager.service",
            "QueryOptions": "$select=EquipId,EquipDesc&$orderby=EquipId"
        }
    },
    "IsVisible": "/SAPAssetManager/Rules/SideDrawer/EnableTechObjectsFacet.js",
    "OnValueChange": "/SAPAssetManager/Rules/Filter/RedrawFilterToolbar.js"
}
